#!/usr/bin/env node
// Spaced-repetition bookkeeping for .codeops/mistakes.md, so no one does date math by hand.
//   codeops-recall              list up to 3 entries due today or earlier, oldest first
//   codeops-recall pass <n>     learner recalled entry n: next interval (1 -> 3 -> 7 -> 14 -> 30 days);
//                               a pass at 30 days retires the entry
//   codeops-recall miss <n>     learner missed entry n: back to 1 day
//   codeops-recall add --concept "<text>" --how "escape hatch|partial hint|hint"
//                      [--exercise <id|n> | --file <path>] [--guess "<text>"]
//                               log help the learner needed; the first check is due tomorrow
const fs = require("node:fs");
const path = require("node:path");

const t = require(path.join(__dirname, "..", "lib", "tracks.js"));
const root = t.learnerRoot(process.cwd());
const file = path.join(root, ".codeops", "mistakes.md");
const steps = [1, 3, 7, 14, 30];
const maxListed = 3;

const { localDate } = t;

const text = fs.existsSync(file) ? fs.readFileSync(file, "utf8") : "";
// Each entry starts with "- " at the beginning of a line; anything before the first one is kept as-is.
const parts = text.split(/^(?=- )/m);
const head = parts[0].startsWith("- ") ? "" : parts.shift();
const field = (entry, name) => entry.match(new RegExp(`^\\s*-?\\s*${name}:\\s*(.+)$`, "m"))?.[1].trim();
const today = localDate();

const [action, nArg] = process.argv.slice(2);

if (action === "add") {
  const opts = {};
  const rest = process.argv.slice(3);
  for (let i = 0; i < rest.length; i += 2) opts[rest[i].replace(/^--/, "")] = rest[i + 1];
  const hows = ["escape hatch", "partial hint", "hint"];
  const fail = (msg) => {
    console.error(msg + " Nothing was logged.");
    process.exit(1);
  };
  if (!opts.concept) fail('Missing --concept "<what they needed help with>".');
  if (!hows.includes(opts.how)) fail(`--how must be one of: ${hows.join(", ")}.`);
  if (opts.exercise && opts.file) fail("Use --exercise or --file, not both.");
  let exercise;
  let attempt;
  let downgrade;
  if (opts.exercise) {
    const progress = t.readProgress(root);
    const track = t.currentTrack(progress);
    const n = String(opts.exercise).padStart(2, "0");
    const id = track.ids.find((d) => d === opts.exercise || d.startsWith(n + "-"));
    if (!id) fail(`No exercise "${opts.exercise}" in ${track.name}.`);
    exercise = `${track.name}/${id}`;
    attempt = t.trackExercises(progress, track.name)[id]?.resets || 0;
    // Help logged after a pass still counts: an escape hatch (or any help on the capstone) makes it assisted.
    const entry = t.trackExercises(progress, track.name)[id];
    if (entry?.status === "passed" && (opts.how === "escape hatch" || id === track.capstone)) {
      downgrade = () => {
        entry.status = "assisted";
        t.writeProgress(root, progress);
        console.log(`${exercise} is now recorded as assisted.`);
      };
    }
  }
  const clean = (s) => String(s).replace(/\s+/g, " ").trim();
  const lines = [`- concept: ${clean(opts.concept)}`];
  if (exercise) lines.push(`  exercise: ${exercise}`, `  attempt: ${attempt}`);
  if (opts.file) lines.push(`  file: ${clean(opts.file)}`);
  lines.push(`  date: ${today}`, `  how: ${opts.how}`);
  if (opts.guess) lines.push(`  guess: ${JSON.stringify(clean(opts.guess))}`);
  lines.push("  interval: 1", `  due: ${localDate(1)}`);
  t.ensureDataDir(root);
  const sep = text && !text.endsWith("\n") ? "\n" : "";
  fs.writeFileSync(file, text + sep + lines.join("\n") + "\n");
  console.log(`Logged "${clean(opts.concept)}"${exercise ? ` for ${exercise}` : ""}. First recall check on ${localDate(1)}.`);
  downgrade?.();
  process.exit(0);
}

if (!action) {
  const due = parts
    .map((entry, i) => ({ n: i + 1, entry }))
    .filter(({ entry }) => !field(entry, "retired") && (field(entry, "due") ?? "9999") <= today)
    .sort((a, b) => field(a.entry, "due").localeCompare(field(b.entry, "due")));
  console.log(`Today: ${today}`);
  if (!due.length) {
    console.log("No recall checks due.");
  } else {
    // A learner returning after a break gets a short warm-up, not a wall of questions.
    console.log(`${due.length} recall check(s) due. Do these ${Math.min(due.length, maxListed)} today:`);
    for (const { n, entry } of due.slice(0, maxListed)) {
      const exercise = field(entry, "exercise");
      console.log(`  #${n}  ${field(entry, "concept")}${exercise ? ` (from ${exercise})` : ""}, due ${field(entry, "due")}`);
    }
    if (due.length > maxListed) console.log(`  (+${due.length - maxListed} more due, for another session)`);
  }
  process.exit(0);
}

const n = Number(nArg);
if (!["pass", "miss"].includes(action) || !Number.isInteger(n) || n < 1 || n > parts.length) {
  console.error("Usage: codeops-recall [pass|miss <entry number>]");
  process.exit(1);
}

let entry = parts[n - 1];
if (field(entry, "retired")) {
  console.error(`#${n} is already retired.`);
  process.exit(1);
}
const dueOn = field(entry, "due");
if (dueOn && dueOn > today) {
  console.error(`#${n} isn't due until ${dueOn}, so it can't be checked yet. Nothing was changed.`);
  process.exit(1);
}
const current = Number(field(entry, "interval")) || 1;
const next = action === "pass" ? (steps.find((s) => s > current) ?? steps.at(-1)) : 1;
const setField = (e, name, value) =>
  new RegExp(`^\\s*${name}:`, "m").test(e)
    ? e.replace(new RegExp(`^(\\s*)${name}:.*$`, "m"), `$1${name}: ${value}`)
    : e.replace(/\n?$/, `\n  ${name}: ${value}\n`);
if (action === "pass" && current >= steps.at(-1)) {
  entry = setField(entry.replace(/^\s*due:.*\n?/m, ""), "retired", today);
  parts[n - 1] = entry;
  fs.writeFileSync(file, head + parts.join(""));
  console.log(`#${n} ${field(entry, "concept")}: recalled after ${current} days. That one's learned, so it's retired.`);
  process.exit(0);
}
entry = setField(entry, "interval", next);
entry = setField(entry, "due", localDate(next));
parts[n - 1] = entry;
fs.writeFileSync(file, head + parts.join(""));
console.log(`#${n} ${field(entry, "concept")}: ${action === "pass" ? "recalled" : "missed"}. Next check in ${next} day(s), on ${localDate(next)}.`);
