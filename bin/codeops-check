#!/usr/bin/env node
// Runs an exercise's tests in the active track and records the result in .codeops/progress.json.
// This is the only thing that marks an exercise as passed.
//   codeops-check <id|n>
const fs = require("node:fs");
const path = require("node:path");
const t = require(path.join(__dirname, "..", "lib", "tracks.js"));

const cwd = t.learnerRoot(process.cwd());
const progress = t.readProgress(cwd);
const track = t.currentTrack(progress);
const arg = process.argv[2];
const n = String(arg ?? "").padStart(2, "0");
const id = arg && track.ids.find((d) => d === arg || d.startsWith(n + "-"));
const dir = id && path.join(t.workspace(cwd, track.name), id);
if (!id || !fs.existsSync(dir)) {
  console.error(`Exercise "${arg ?? ""}" isn't set up in ${track.name}. Run codeops-exercise <id> first.`);
  process.exit(1);
}

// Exercises the learner needed help on, from .codeops/mistakes.md. Entries name them as
// "exercise: <track>/<id>"; the original JavaScript track also accepts a bare "<id>".
// An escape-hatch entry makes a pass "assisted"; for the capstone, any help does.
function helpUsed() {
  let text = "";
  try {
    text = fs.readFileSync(path.join(cwd, ".codeops", "mistakes.md"), "utf8");
  } catch {}
  const prefix = track.name === t.defaultTrack ? `(?:${track.name}/)?` : `${track.name}/`;
  const pattern = new RegExp(`exercise:\\s*${prefix}${id}\\b`);
  const entries = text.split(/^- /m).filter((e) => pattern.test(e));
  if (id === track.capstone) return entries.length > 0;
  return entries.some((e) => /how:\s*escape hatch/.test(e));
}

const check = t.prepareCheck(track, id, dir);
// Remove the temp copy however the script ends, including Ctrl-C.
process.on("exit", check.cleanup);
for (const signal of ["SIGINT", "SIGTERM"]) process.on(signal, () => process.exit(130));

(async () => {
  const run = await t.runTests(track, check.dir);
  if (run.missing) {
    console.error(run.output);
    process.exit(2);
  }

  const entry = (t.trackExercises(progress, track.name)[id] ??= { status: "in_progress", attempts: 0 });
  entry.attempts += 1;

  let result;
  if (run.status === 0) {
    result = helpUsed() ? "assisted" : "passed";
    if (entry.status !== "passed") entry.status = result;
    entry.passed_at ??= t.localDate();
  } else {
    result = run.timedOut ? "failing (timed out)" : "failing";
    if (!["passed", "assisted"].includes(entry.status)) entry.status = "in_progress";
  }
  t.writeProgress(cwd, progress);

  // Tests ran in a temp copy; point file paths in the output at the learner's own files instead.
  const shown = path.relative(cwd, dir) + path.sep;
  let output = run.output;
  // Longest first: on macOS the temp dir's real path (/private/var/...) contains its short form (/var/...).
  const temps = [...new Set([fs.realpathSync(check.dir), check.dir])].sort((a, b) => b.length - a.length);
  for (const temp of temps) output = output.split(temp + path.sep).join(shown);
  console.log(output.split("\n").slice(-40).join("\n"));
  for (const name of check.changed) {
    console.log(`\nNOTE: your copy of ${name} differs from the original, so this was checked against the original test.`);
  }
  console.log(`\nRESULT: ${track.name}/${id} ${result} (test run ${entry.attempts})`);
  if (result === "assisted" && id === track.capstone) {
    console.log("The capstone passed with help, so it's recorded as assisted and the track isn't marked complete.");
  }
})();
