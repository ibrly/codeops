#!/usr/bin/env node
// Runs an exercise's tests in the active track and records the result in .codeops/progress.json.
// This is the only thing that marks an exercise as passed.
//   codeops-check <id|n>
const fs = require("node:fs");
const path = require("node:path");
const t = require(path.join(__dirname, "..", "lib", "tracks.js"));

const usage = `Usage: codeops-check <exercise>
  Runs that exercise's tests and records the result. <exercise> is its number or name,
  like 3 or 03-loops. Example: codeops-check 3`;
if (!process.argv[2] || ["--help", "-h"].includes(process.argv[2])) {
  console.log(usage);
  process.exit(process.argv[2] ? 0 : 1);
}

const cwd = t.learnerRoot(process.cwd());
const progress = t.readProgress(cwd);
const track = t.currentTrack(progress);
const arg = process.argv[2];
const n = String(arg ?? "").padStart(2, "0");
const id = arg && track.ids.find((d) => d === arg || d.startsWith(n + "-"));
const dir = id && path.join(t.workspace(cwd, track.name), id);
if (!id || !fs.existsSync(dir)) {
  console.error(`There's no exercise ${arg} set up in the ${track.name} track yet. Set it up first with: codeops-exercise ${arg}`);
  process.exit(1);
}

// Exercises the learner needed help on, from .codeops/mistakes.md. Entries name them as
// "exercise: <track>/<id>"; the original JavaScript track also accepts a bare "<id>".
// An escape-hatch entry makes a pass "assisted"; for the capstone, any help does.
// Only help on the current copy counts ("fresh_copy: N", or "attempt: N" in older logs; none means 0), so a
// reset and an unaided redo can earn "passed". A redo on the same day as an earlier escape hatch
// doesn't count, because the answer is still fresh.
function helpUsed(attempt) {
  let text = "";
  try {
    text = fs.readFileSync(path.join(cwd, ".codeops", "mistakes.md"), "utf8");
  } catch {}
  const prefix = track.name === t.defaultTrack ? `(?:${track.name}/)?` : `${track.name}/`;
  const pattern = new RegExp(`exercise:\\s*${prefix}${id}\\b`);
  const entries = text.split(/^- /m).filter((e) => pattern.test(e));
  const attemptOf = (e) => Number(/(?:fresh_copy|attempt):\s*(\d+)/.exec(e)?.[1] ?? 0);
  const counts = (e) => id === track.capstone || /how:\s*escape hatch/.test(e);
  if (entries.some((e) => attemptOf(e) === attempt && counts(e))) return true;
  return entries.some((e) => attemptOf(e) < attempt && /how:\s*escape hatch/.test(e) && e.includes(`date: ${t.localDate()}`));
}

const check = t.prepareCheck(track, id, dir);
// Remove the temp copy however the script ends, including Ctrl-C.
process.on("exit", () => {
  t.killRunning();
  check.cleanup();
});
for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(signal, () => process.exit(130));

(async () => {
  const run = await t.runTests(track, check.dir);
  if (run.missing) {
    console.error(run.output);
    process.exit(2);
  }

  // Re-read progress now: the test run took a while, and other helpers may have written meanwhile.
  let result;
  const entry = t.updateProgress(cwd, (fresh) => {
    const entry = (t.trackExercises(fresh, track.name)[id] ??= { status: "in_progress", attempts: 0 });
    entry.attempts += 1;
    if (t.runPassed(track, run, check.expected)) {
      result = helpUsed(entry.resets || 0) ? "assisted" : "passed";
      if (entry.status === "assisted" && result === "passed") entry.redone = true;
      // Help on the current attempt always counts, even if this exercise passed unaided before.
      if (result === "assisted" || entry.status !== "passed") entry.status = result;
      entry.passed_at ??= t.localDate();
    } else {
      result = run.timedOut ? "failing (timed out)" : "failing";
      if (!["passed", "assisted"].includes(entry.status)) entry.status = "in_progress";
    }
    return entry;
  });

  // Tests ran in a temp copy; point file paths in the output at the learner's own files instead.
  const shown = path.relative(cwd, dir) + path.sep;
  let output = run.output;
  // Match on the temp dir's unique name rather than its full path, which can appear as /var or
  // /private/var on macOS, and with short (RUNNER~1) or escaped (C:\\Users) forms on Windows.
  const tempPath = new RegExp(`[^\\s'"()]*${path.basename(check.dir)}(?:\\\\\\\\|\\\\|/)`, "g");
  output = output.replace(tempPath, shown);
  // For reading, drop Node's internal stack frames and TAP bookkeeping, so the learner's own
  // lines and the error messages are what's left. (Passing is judged on the raw output above.)
  const noise = [
    /\(?node:(internal|async_hooks)/,
    /^\s*(async )?(Test|AsyncResource|TestContext\.run|Suite)\.\S+ \(/,
    /^\s*(duration_ms|failureType|code|type):/,
    /^\s*(---|\.\.\.)$/,
    /^# (suites|cancelled|skipped|todo|duration_ms)\b/,
    /^TAP version/,
  ];
  const lines = output.split("\n").filter((line) => !(track.test[0] === "node" && noise.some((re) => re.test(line))));
  console.log(lines.slice(-60).join("\n"));
  for (const name of check.shadowing) {
    console.log(`\nNOTE: ${name} in your folder has the same name as Python's test runner, so it was left out of the check. Rename it.`);
  }
  if (run.status === 0 && !t.runPassed(track, run, check.expected)) {
    console.log(`\nNOTE: the run exited without the expected ${check.expected} test(s) all passing (maybe the code stops the program early), so it doesn't count as passed.`);
  }
  for (const name of check.changed) {
    console.log(`\nNOTE: your copy of ${name} differs from the original, so this was checked against the original test.`);
  }
  console.log(`\nRESULT: ${track.name}/${id} ${result} (test run ${entry.attempts})`);
  if (result === "passed" || result === "assisted") {
    const done = t.readProgress(cwd).tracks[track.name]?.exercises ?? {};
    const next = track.ids.find((other) => !["passed", "assisted"].includes(done[other]?.status));
    if (next) console.log(`Next: ${next} (set it up with: codeops-exercise ${next.slice(0, 2).replace(/^0/, "")})`);
    else console.log("Next: every exercise in this track is done. See codeops-exercise --list.");
  }
  if (result === "assisted" && id === track.capstone) {
    console.log("The capstone passed with help, so it's recorded as assisted and the track isn't marked complete.");
  }
})();
