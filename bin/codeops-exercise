#!/usr/bin/env node
// Lists exercises, switches tracks, or copies an exercise into the learner's folder.
//   codeops-exercise --list           exercises in the active track, with status and the next one
//   codeops-exercise --tracks         every available track
//   codeops-exercise --track <name>   switch the active track
//   codeops-exercise --taught <id|n>  record that the learner taught this concept back
//   codeops-exercise --reset <id|n>   back up the learner's copy to .codeops/backups/ and start fresh
//   codeops-exercise <id|n>           set up an exercise (e.g. 03-loops or 3) and print its README
const fs = require("node:fs");
const path = require("node:path");
const t = require(path.join(__dirname, "..", "lib", "tracks.js"));

const cwd = t.learnerRoot(process.cwd());
const [arg, value] = process.argv.slice(2);

if (["--help", "-h"].includes(arg)) {
  console.log(`Usage:
  codeops-exercise --list            show the exercises in your track and which one is next
  codeops-exercise <exercise>        set up an exercise (its number or name, like 3 or 03-loops)
  codeops-exercise --tracks          show every track you can switch to
  codeops-exercise --track <name>    switch track, e.g. --track foundations-python
  codeops-exercise --reset <exercise>   start an exercise again (your old copy is backed up)
  codeops-exercise --taught <exercise>  record that you taught this concept back
  codeops-exercise --report          a summary to share as feedback, with nothing personal in it`);
  process.exit(0);
}
for (const flag of ["--track", "--reset", "--taught"]) {
  if (arg === flag && !value) {
    console.error(`${flag} needs a value. Run codeops-exercise --help to see how to use it.`);
    process.exit(1);
  }
}
const progress = t.readProgress(cwd);

if (arg === "--report") {
  // A shareable summary for pilot feedback: statuses and help counts only. It never includes
  // notes.md, the learner's guesses, their code, or file paths.
  const version = JSON.parse(fs.readFileSync(path.join(__dirname, "..", ".claude-plugin", "plugin.json"), "utf8")).version;
  console.log(`CodeOps ${version} · Node ${process.versions.node} · ${process.platform}`);
  for (const name of t.listTracks()) {
    const done = progress.tracks[name]?.exercises ?? {};
    for (const [id, e] of Object.entries(done).sort()) {
      console.log(`${name}/${id}: ${e.status}, ${e.attempts || 0} test run(s)${e.resets ? `, ${e.resets} reset(s)` : ""}${e.taught ? ", taught" : ""}`);
    }
  }
  let log = "";
  try {
    log = fs.readFileSync(path.join(cwd, ".codeops", "mistakes.md"), "utf8");
  } catch {}
  const entries = log.split(/^- /m).filter((e) => /concept:/.test(e));
  const field = (e, k) => new RegExp(`^\\s*-?\\s*${k}:\\s*(.+)$`, "m").exec(e)?.[1].trim();
  console.log(entries.length ? `\nHelp logged (${entries.length}):` : "\nNo help logged.");
  for (const e of entries) {
    const where = field(e, "exercise") ?? (field(e, "file") ? "own project" : "");
    console.log(`- ${field(e, "date") ?? "?"} · ${field(e, "how") ?? "?"} · ${field(e, "concept") ?? "?"}${where ? ` · ${where}` : ""}${field(e, "retired") ? " · retired" : ""}`);
  }
  process.exit(0);
}

if (arg === "--tracks") {
  // Every track, with honest counts for the ones the learner has started.
  for (const name of t.listTracks()) {
    const track = t.loadTrack(name);
    const done = progress.tracks[name]?.exercises ?? {};
    const count = (status) => track.ids.filter((id) => done[id]?.status === status).length;
    let summary = "";
    if (Object.keys(done).length) {
      const capstone = done[track.capstone]?.status;
      const state = capstone === "passed" ? "complete" : capstone === "assisted" ? "capstone assisted" : "in progress";
      summary = ` · ${count("passed")} passed, ${count("assisted")} assisted, of ${track.ids.length} · ${state}`;
    }
    console.log(`${name === t.activeTrack(progress) ? "→" : " "} ${name.padEnd(20)} ${track.title} · ${track.language}${summary}`);
  }
  process.exit(0);
}

if (arg === "--track") {
  if (!value || !t.loadTrack(value)) {
    console.error(`No track "${value ?? ""}". Available: ${t.listTracks().join(", ")}`);
    process.exit(1);
  }
  const problem = t.checkRuntime(t.loadTrack(value));
  if (problem) {
    console.error(problem + "\nThe track wasn't changed.");
    process.exit(1);
  }
  progress.track = value;
  t.trackExercises(progress, value);
  t.writeProgress(cwd, progress);
  const track = t.loadTrack(value);
  console.log(`Active track: ${value} (${track.title} · ${track.language})`);
  process.exit(0);
}

const track = t.currentTrack(progress);
const done = progress.tracks[track.name]?.exercises ?? {};

if (!arg || arg === "--list") {
  console.log(`Track: ${track.name} · ${track.title} · tests: ${track.test.join(" ")} · capstone: ${track.capstone}\n`);
  const next = track.ids.find((id) => !["passed", "assisted"].includes(done[id]?.status));
  for (const id of track.ids) {
    const p = done[id];
    const status = p ? `${p.status}${p.attempts ? `, ${p.attempts} test run(s)` : ""}${p.taught ? ", taught" : ""}` : "not started";
    console.log(`${id === next ? "→" : " "} ${id.padEnd(20)} ${status}`);
  }
  const capstone = done[track.capstone]?.status;
  if (capstone === "passed") {
    console.log(track.next ? `\nTrack complete. Next: codeops-exercise --track ${track.next}` : "\nTrack complete.");
  } else if (capstone === "assisted" && !next) {
    console.log(`\nCapstone assisted: redo it unaided on a later day with codeops-exercise --reset ${track.capstone}`);
  } else {
    console.log(`\nNext exercise: ${next ?? track.capstone}`);
  }
  process.exit(0);
}

const wanted = ["--taught", "--reset"].includes(arg) ? value : arg;
const n = String(wanted ?? "").padStart(2, "0");
const id = track.ids.find((d) => d === wanted || d.startsWith(n + "-"));
if (!id) {
  console.error(`No exercise "${wanted ?? ""}" in ${track.name}. Run codeops-exercise --list to see them.`);
  process.exit(1);
}

if (arg === "--taught") {
  const entry = t.trackExercises(progress, track.name)[id];
  if (!entry || !["passed", "assisted"].includes(entry.status)) {
    console.error(`${id} hasn't been passed yet, so it can't be marked as taught.`);
    process.exit(1);
  }
  entry.taught = true;
  t.writeProgress(cwd, progress);
  console.log(`Recorded: ${track.name}/${id} taught back.`);
  process.exit(0);
}

const target = path.join(t.workspace(cwd, track.name), id);

if (arg === "--reset") {
  if (!fs.existsSync(target)) {
    console.error(`${id} isn't set up yet, so there's nothing to reset.`);
    process.exit(1);
  }
  const backups = path.join(t.ensureDataDir(cwd), "backups");
  let n = 1;
  while (fs.existsSync(path.join(backups, `${track.name}-${id}-${t.localDate()}-${n}`))) n++;
  const backup = path.join(backups, `${track.name}-${id}-${t.localDate()}-${n}`);
  fs.mkdirSync(backups, { recursive: true });
  try {
    fs.renameSync(target, backup);
  } catch (err) {
    // On Windows a folder that's open somewhere (a terminal inside it, an editor) can't be moved,
    // so copy it to the backup and empty it instead.
    if (!["EBUSY", "EPERM", "EXDEV", "EACCES"].includes(err.code)) throw err;
    fs.cpSync(target, backup, { recursive: true });
    for (const entry of fs.readdirSync(target)) fs.rmSync(path.join(target, entry), { recursive: true, force: true });
    fs.rmSync(target, { recursive: true, force: true });
  }
  // A reset starts a new attempt: help logged on earlier attempts no longer counts against it.
  const entry = t.trackExercises(progress, track.name)[id];
  if (entry) entry.resets = (entry.resets || 0) + 1;
  console.log(`Your previous attempt is saved in ${path.relative(cwd, backup)}/`);
}
// Keep caches from the learner's own test runs out of git if they commit their work.
const ignore = path.join(t.workspace(cwd, track.name), ".gitignore");
if (!fs.existsSync(ignore)) {
  fs.mkdirSync(path.dirname(ignore), { recursive: true });
  fs.writeFileSync(ignore, "__pycache__/\nnode_modules/\n");
}
if (fs.existsSync(target)) {
  console.log(`Already set up at ${path.relative(cwd, target)}/ (your changes are kept). Full path: ${target}`);
} else {
  fs.cpSync(path.join(track.exercises, id), target, { recursive: true });
  console.log(`Set up ${id} at ${path.relative(cwd, target)}/ (full path: ${target})`);
}

t.trackExercises(progress, track.name)[id] ??= { status: "in_progress", attempts: 0 };
t.writeProgress(cwd, progress);

console.log(`Run its tests from that folder with: ${track.test.join(" ")}`);
console.log(`Files: ${fs.readdirSync(target).join(", ")}\n`);
console.log(fs.readFileSync(path.join(target, "README.md"), "utf8"));
